# Copy to .env and fill in.
# DO NOT COMMIT .env — it's in .gitignore.

# ── Evolution API ────────────────────────────────────────────
# Generate a strong random key (e.g. `openssl rand -hex 24`).
# This is what you'll log in to the Evolution manager UI with,
# AND what the POC server uses to call the Evolution API.
EVOLUTION_API_KEY=replace-me-with-a-strong-random-string

# Postgres password for Evolution's session storage.
# Random; only Evolution + Postgres see it.
EVOLUTION_DB_PASSWORD=replace-me-with-another-random-string

# Public URL of the Evolution API as seen from OUTSIDE the
# docker network. For local POC this is the host port mapping.
EVOLUTION_PUBLIC_URL=http://localhost:8080

# Instance name (just a label; pick anything alphanumeric).
EVOLUTION_INSTANCE=bimi-poc

# ── POC server ───────────────────────────────────────────────
# Port the FastAPI POC server listens on.
POC_PORT=9000

# Webhook URL Evolution should POST events to.
# `host.docker.internal` lets the Evolution container reach
# the POC server running on your Mac's host. (Linux users:
# use `--add-host=host.docker.internal:host-gateway` on docker compose.)
POC_WEBHOOK_URL=http://host.docker.internal:9000/webhook
