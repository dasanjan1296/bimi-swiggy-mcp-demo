# ============================================================
# Bimi — Root .gitignore
# ============================================================

# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.sublime-*

# --- Secrets / Env ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision
google-service-account.json
firebase-service-account.json
service-account*.json

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# Node / JavaScript / TypeScript
# ============================================================
node_modules/
dist/
build/
.next/
out/
coverage/
.turbo/
.cache/
*.tsbuildinfo

# ============================================================
# Expo / React Native (bimi/app)
# ============================================================
.expo/
.expo-shared/
web-build/
expo-env.d.ts
*.orig.*

# Native build artifacts (regenerated by `expo prebuild`)
app/ios/
app/android/

# @generated expo-cli sync
# expo-env.d.ts intentionally ignored above

# ============================================================
# Vite / Frontend (bimi/frontend)
# ============================================================
frontend/dist/
frontend/.vite/

# ============================================================
# Python / FastAPI (bimi/backend)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/
.eggs/
pip-wheel-metadata/

# Alembic — keep migration files, ignore local DBs
*.db
*.sqlite
*.sqlite3

# Backend session/cache artifacts
backend/sessions/
backend/.cache/

# ============================================================
# MCP server local data
# ============================================================
backend/mcps/**/node_modules/
backend/mcps/**/dist/

# ============================================================
# Generated reports & screenshots (large, regenerated)
# ============================================================
app/screenshots/
app/reports/
landing/*.pdf

# ============================================================
# Misc
# ============================================================
*.tmp
*.bak
.tmp/
