# Bimi backend configuration.
# Copy to `.env` and fill in values for the env you're targeting.
#
# ─── Production hardening ────────────────────────────────────────────
# When BIMI_ENV=production, app/startup_checks.py REFUSES to start
# unless every required value below is set. That's intentional — a
# silent half-configured prod is worse than a loud crash.

# === REQUIRED ───────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/bimi
# Local dev without Postgres? Swap to the aiosqlite driver:
#   DATABASE_URL=sqlite+aiosqlite:///./bimi-dev.db
# Schema-level features (Alembic migrations, JSONB columns, etc.) are
# tuned for Postgres — SQLite is fine for a clone-and-poke session, not
# for end-to-end correctness.
OPENAI_API_KEY=sk-...
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Deployment env: development | staging | test | production
BIMI_ENV=development

# === WHATSAPP (required for real bot in production) ────────────────

WHATSAPP_TOKEN=EAAxxxxxxx...
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Set to a non-default value before going to prod. The string
# `bimi-verify` is in the public repo — anyone reading it can spoof
# Meta's GET /webhook handshake. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
WHATSAPP_VERIFY_TOKEN=bimi-verify
# From Meta App Settings → App Secret. Used to verify Meta's
# X-Hub-Signature-256 on inbound webhooks. Without this, anyone can
# POST forged messages to /api/webhook in production.
WHATSAPP_APP_SECRET=

# === OTP / SMS (AuthKey.io) ─────────────────────────────────────────

# Get these from https://app.authkey.io → API Keys and SMS Templates.
# Production gate: real SMS only fires when BIMI_ENV=production AND
# AUTHKEY_API_KEY is set. In dev/staging/test, OTPs are logged to
# the console.
#
# Demo / App-Store-reviewer bypass works in every environment:
#   Phone: +910000000000   OTP: 0000
AUTHKEY_API_KEY=
AUTHKEY_TEMPLATE_SID=30729

# === OPTIONAL — voice transcription / TTS ──────────────────────────

# Sarvam Saaras V3 — Hindi voice transcription. Without this,
# voice notes fall back to OpenAI Whisper (worse on Indian accents).
SARVAM_API_KEY=

# Cook-facing voice replies (Sarvam TTS). When False (default), the
# system sends text instead of voice. Flip to True ONLY after Sarvam
# TTS quotas are confirmed in your account.
USE_REAL_VOICE_REPLIES=false
# Below this transcript-confidence threshold, we send the user a
# best-guess fallback ("Kya aap yeh kehna chah rahe the…?") instead
# of running full intent extraction.
VOICE_LOW_CONFIDENCE_THRESHOLD=0.45

# === OPTIONAL — Swiggy MCP (Builders Club) ─────────────────────────

# These come from the Swiggy Developer Application form. Until the
# Builders Club application is approved, leave SWIGGY_MCP_CLIENT_SECRET
# empty and the OAuth flow will mint synthetic tokens for testing.
SWIGGY_MCP_CLIENT_ID=bimi-app
SWIGGY_MCP_CLIENT_SECRET=
SWIGGY_MCP_REDIRECT_URI=http://localhost:8002/api/swiggy/auth/callback
# Legacy single-tenant token (deprecated by per-family OAuth)
SWIGGY_MCP_AUTH_TOKEN=

# === FIREBASE — push notifications ─────────────────────────────────

# Two ways to provide credentials. Production (Render) uses the env
# var; the path is mostly for local dev where you want a file on disk.
#
# Paste the entire service-account JSON as a single line:
FIREBASE_CREDENTIALS_JSON=
# OR point at a file on disk (used only when JSON env var is unset):
FIREBASE_CREDENTIALS_PATH=

# === OBSERVABILITY — Sentry ────────────────────────────────────────

# Empty DSN disables Sentry entirely. When set, the SDK auto-wires
# the FastAPI integration via app/observability.py.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Override the sentry environment tag (defaults to BIMI_ENV).
SENTRY_ENVIRONMENT=

# === APP CONFIG ─────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:5173
# Rate-limit budget per IP per minute. Production keeps the
# conservative default; dev/test environments often set this higher
# so E2E suites don't false-positive on 429.
RATE_LIMIT_PER_MINUTE=600

# === WORKER PROCESS ─────────────────────────────────────────────────

# Set to "1" on the web tier and "0" on the worker tier. Fly.io
# process groups (see fly.toml) wire this automatically. APScheduler
# must run in exactly ONE process to avoid double-firing scheduled jobs.
BIMI_DISABLE_SCHEDULER=0
